{
    "root": true,
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "globals": {
        "Alpine": "readonly",
        "Livewire": "readonly",
        "Echo": "readonly",
        "axios": "readonly",
        "Chart": "readonly",
        "tinymce": "readonly",
        "$": "readonly",
        "jQuery": "readonly"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-undef": "error",
        "no-console": "off"
    }
}
