{
    "name": "smart-african-marketplace",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "audit:fix": "npm audit fix --force",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "security-check": "npm audit --audit-level=high",
        "lint": "eslint resources/js --ext .js",
        "lint:fix": "eslint resources/js --ext .js --fix",
        "format": "prettier --check \"resources/**/*.{js,css,json,md}\"",
        "format:fix": "prettier --write \"resources/**/*.{js,css,json,md}\"",
        "clean": "rimraf public/build"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.0",
        "@tailwindcss/forms": "^0.5.7",
        "@typescript-eslint/eslint-plugin": "^8.61.1",
        "@typescript-eslint/parser": "^8.61.1",
        "alpinejs": "^3.15.12",
        "autoprefixer": "^10.5.0",
        "axios": "^1.9.0",
        "eslint": "^8.57.1",
        "laravel-vite-plugin": "^3.1.0",
        "playwright": "^1.61.0",
        "postcss": "^8.5.10",
        "prettier": "^3.8.4",
        "rimraf": "^6.1.3",
        "tailwindcss": "^3.4.19",
        "vite": "^8.0.15"
    },
    "dependencies": {
        "chart.js": "^4.5.1",
        "laravel-echo": "^1.19.0",
        "pusher-js": "^8.5.0",
        "tinymce": "^8.6.0"
    }
}
