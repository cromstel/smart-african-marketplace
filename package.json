{
    "name": "smart-african-marketplace",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "audit:fix": "npm audit fix",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "security-check": "npm audit --audit-level=high",
        "lint": "eslint resources/js --ext .js",
        "lint:fix": "eslint resources/js --ext .js --fix",
        "format": "prettier --check \"resources/**/*.{js,css,json,md}\"",
        "format:fix": "prettier --write \"resources/**/*.{js,css,json,md}\"",
        "clean": "rimraf public/build",
        "soketi": "cd soketi && npm start"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.18.1",
        "eslint": "^8.57.1",
        "esbuild": "^0.28.1",
        "laravel-vite-plugin": "^3.0.0",
        "playwright": "^1.58.2",
        "postcss": "^8.4.31",
        "prettier": "^3.3.3",
        "rimraf": "^5.0.10",
        "tailwindcss": "^3.1.0",
        "vite": "^8.1.4"
    },
    "dependencies": {
        "chart.js": "^4.5.1",
        "laravel-echo": "^1.16.1",
        "pusher-js": "^8.4.0",
        "tinymce": "^7.9.3"
    },
    "overrides": {
        "picomatch@2.3.1": "2.3.2",
        "picomatch@4.0.3": "4.0.4"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
