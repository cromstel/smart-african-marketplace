{
    "name": "african-market/ecommerce",
    "type": "project",
    "description": "African Market E-commerce Platform - CMS-style installable marketplace for African products and services",
    "keywords": [
        "ecommerce",
        "african-market",
        "laravel",
        "marketplace",
        "salon-booking",
        "multi-vendor"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "barryvdh/laravel-dompdf": "dev-master",
        "endroid/qr-code": "^6.0",
        "intervention/image": "^2.7|^3.0",
        "laravel/cashier": "^15.8|^17.0",
        "laravel/framework": "^12.60",
        "laravel/sanctum": "^3.3|^4.0",
        "laravel/socialite": "^5.24|^5.28",
        "laravel/tinker": "^2.8",
        "livewire/livewire": "^3.0|^4.0",
        "spatie/laravel-activitylog": "^4.7|^5.0",
        "spatie/laravel-permission": "^6.24|^8.0",
        "spatie/laravel-sluggable": "^3.5|^4.0",
        "stripe/stripe-php": "^16.2|^20.0",
        "twilio/sdk": "^8.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.22",
        "laravel/breeze": "*",
        "laravel/pint": "^1.15",
        "laravel/sail": "^1.18|^2.0",
        "laravel/telescope": "^4.17|^5.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.0|^8.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "spatie/laravel-ignition": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "install-app": [
            "composer install",
            "php artisan key:generate",
            "php artisan migrate --force",
            "php artisan db:seed --force",
            "php artisan storage:link",
            "npm install",
            "npm run build"
        ],
        "setup": [
            "composer install",
            "npm install"
        ],
        "dev": [
            "php artisan serve"
        ],
        "test": [
            "@php artisan test"
        ],
        "format": [
            "./vendor/bin/pint"
        ],
        "security-check": [
            "@php -r \"echo 'Run: npm audit && composer audit --no-security-blocking\\n';\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
